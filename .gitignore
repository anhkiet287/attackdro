# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.python-version

# Data & model artifacts (keep the repo light)
# Anchored to repo root — an unanchored `data/` also swallows src/robustdro/data/.
/data/
!/data/.gitkeep
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
runs/
checkpoints/
outputs/
results/
wandb/
lightning_logs/
*.log

# Notebooks
.ipynb_checkpoints/
notebooks/*.ipynb_outputs/
notebooks/**/*.ipynb_outputs/
colab_outputs/
drive_outputs/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Job-queue runtime (keep the folder structure via .gitkeep)
jobs/queue/*
jobs/running/*
jobs/done/*
jobs/failed/*
jobs/logs/*
jobs/agent.out
!jobs/**/.gitkeep

# Secrets
.env
*.key
.git.broken.bak/

# Training logs
logs/

# External baseline repos (not ours)
external/

# leaked ramp virtualenv (never commit)
.venv-ramp/
.venv*/
